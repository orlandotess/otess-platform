# Copia este archivo a .env.local y llena los valores desde
# Vercel > el proyecto > Settings > Environment Variables.
#
# Nota: la URL de Supabase y la anon key NO van aquí — están escritas
# directamente en lib/supabase.js, así que la app arranca sin este archivo.
# Lo que sigue es lo que hace falta para que funcione de verdad.

# --- Requeridas para poder entrar y ver datos en local ---

# Service role key de Supabase (Settings > API > service_role).
# La usan los server components (lib/supabase.js), el login
# (app/api/login/route.js) y el reset de contraseña. Sin esta,
# POST /api/login responde 500 y no se puede iniciar sesión.
SUPABASE_SERVICE_ROLE_KEY=

# Misma service role key, leída aparte por el middleware (middleware.js)
# para resolver el rol del usuario. Sin esta, el middleware falla en
# silencio y todo el mundo entra como 'tecnico', incluidos los admin.
SUPABASE_SERVICE_ROLE_KEY_MW=

# --- Opcionales, solo si vas a probar esa función en local ---

# Resend (envío de correo: estimas, facturas, propuestas, recordatorios).
RESEND_API_KEY=

# Protege las rutas de cron que Vercel dispara según vercel.json
# (facturas recurrentes, recordatorios, respaldo de fotos, etc.).
CRON_SECRET=

# Autoriza el feed ICS del calendario (app/api/calendar/feed/route.js).
CALENDAR_ADMIN_TOKEN=

# Resend > Webhooks > signing secret, mostrado una sola vez al crear el webhook
# (lo verifica app/api/service-tickets/inbound/route.js para el correo entrante).
RESEND_WEBHOOK_SECRET=

# Cloudflare > R2 > Manage API Tokens (app/api/backup-storage/run/route.js
# espeja el bucket Job-photos hacia R2 — los respaldos diarios de Supabase
# no cubren Storage).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=otess-storage-backup
