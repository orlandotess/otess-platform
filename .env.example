NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx

# From Resend dashboard > Webhooks > signing secret shown once when the webhook is created
# (used by app/api/service-tickets/inbound/route.js to verify inbound-email webhook calls)
RESEND_WEBHOOK_SECRET=whsec_xxxx

# Cloudflare dashboard > R2 > Manage API Tokens (used by app/api/backup-storage/run/route.js
# to mirror the Job-photos storage bucket into R2 — Supabase's daily backups don't cover Storage)
R2_ACCOUNT_ID=xxxx
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET_NAME=otess-storage-backup
